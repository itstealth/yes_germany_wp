# YES Germany staging — environment template.
#
# Copy to .env on the host and fill in real values. The real .env lives ONLY on
# the server (/opt/yesgermany/staging/.env, chmod 600) and is never committed.
#
#   cp .env.example .env && chmod 600 .env

# --- Database -------------------------------------------------------------
# A dedicated staging database. Never point this at the production database.
DB_NAME=yg_staging
DB_USER=yg_staging
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_ROOT_PASSWORD=CHANGE_ME_DIFFERENT_STRONG_PASSWORD

# Must match the production prefix so the imported dump lines up.
TABLE_PREFIX=wpb9_

# --- Site -----------------------------------------------------------------
SITE_URL=https://yg-staging.stealthlearn.in

# Origin that staging reads missing uploads from, read-only.
# Staging cannot write here; see docker/nginx/default.conf.
UPLOADS_PROXY=https://www.yesgermany.com
